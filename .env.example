# BeaconAI Multi-Provider Configuration

# Model Selection (Any valid LiteLLM model string)
# Examples:
#   Google Gemini: gemini/gemini-2.5-flash, gemini/gemini-1.5-pro
#   Anthropic:     claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   OpenAI:        gpt-4o, gpt-4o-mini
#   Local Ollama:  ollama/llama3.2, ollama/mistral
LLM_MODEL=gemini/gemini-2.5-flash

# API Credentials (Set key corresponding to your chosen LLM_MODEL)
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_API_BASE=http://localhost:11434

# SQLite Database path
DB_PATH=matches.db

# Circuit Breaker: Max Tier-2 LLM evaluations allowed per single execution run
MAX_LLM_EVALS_PER_RUN=20

# Polite RSS Ingestion
USER_AGENT=BeaconAI/1.0 (+https://github.com/beacon-ai; polite-job-crawler)
REQUEST_TIMEOUT_SECONDS=15

# Resend Transactional Email Alerts
# RESEND_API_KEY=re_123456789
# NOTIFICATION_EMAIL_TO=you@example.com
NOTIFICATION_EMAIL_FROM=BeaconAI <alerts@example.com>

# Output directories
ARTIFACTS_DIR=artifacts
MATCHES_DIR=artifacts/matches

