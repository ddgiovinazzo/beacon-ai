# BeaconAI Configuration

# Gemini API Key (Required for Tier 2 evaluation and resume generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database path
DB_PATH=matches.db

# Circuit Breaker: Max Tier-2 LLM evaluations allowed per single execution run
MAX_LLM_EVALS_PER_RUN=20

# Polite RSS Ingestion
USER_AGENT=BeaconAI/1.0 (+https://github.com/beacon-ai; polite-job-crawler)
REQUEST_TIMEOUT_SECONDS=15

# Output directories
ARTIFACTS_DIR=artifacts
MATCHES_DIR=artifacts/matches
