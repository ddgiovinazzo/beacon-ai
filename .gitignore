# Environment and secrets
.env
*.env

# Candidate Profiles (zero-storage protection for ephemeral secrets)
profiles/*.json
!profiles/*.example
!profiles/*.example.json

# SQLite Databases
*.db
!matches.db
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# Artifacts (ignore candidate-tailored resumes, PDFs, outreach drafts, and daily digests)
artifacts/matches/
artifacts/daily_digest_*.md
!artifacts/.gitkeep

# Virtual Environment
.venv/
env/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# IDE & OS
.DS_Store
.idea/
.vscode/
