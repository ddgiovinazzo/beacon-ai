<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f8fafc; margin: 0; padding: 20px; }
  .card { background-color: #ffffff; max-width: 600px; margin: 0 auto; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; }
  .header { background-color: #0f172a; color: #ffffff; padding: 20px 24px; }
  .body { padding: 20px 24px; color: #334155; line-height: 1.5; }
  .meta-table { width: 100%; border-collapse: collapse; margin: 14px 0; }
  .meta-table td { padding: 6px 10px; border: 1px solid #f1f5f9; font-size: 13px; }
  .meta-label { background-color: #f8fafc; font-weight: 600; width: 32%; color: #475569; }
  .footer { background-color: #f1f5f9; padding: 12px 24px; text-align: center; font-size: 10px; color: #94a3b8; line-height: 1.4; }
</style>
</head>
<body>
<div class="card">
  <div class="header">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 12px; width: auto;">
      <tr>
        <td style="color: #94a3b8; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding-right: 10px; vertical-align: middle;">
          BEACONAI JOB ALERT
        </td>
        <td style="vertical-align: middle;">
          <span style="background-color: {% if match_score >= 70 %}#10b981{% elif match_score >= 50 %}#0ea5e9{% else %}#f59e0b{% endif %}; color: #ffffff; font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 9999px; display: inline-block; line-height: 1.2;">
            {{ match_score }}/100 MATCH
          </span>
        </td>
      </tr>
    </table>
    <h1 style="margin: 0 0 4px 0; font-size: 20px; color: #ffffff; line-height: 1.3;">{{ job_title }}</h1>
    <div style="font-size: 13px; color: #cbd5e1;">Source: {{ job_source }}</div>
  </div>
  <div class="body">
    <table class="meta-table">
      <tr>
        <td class="meta-label">Direct Posting</td>
        <td><a href="{{ posting_url }}" style="color: #2563eb; text-decoration: none;">View Original Posting ↗</a></td>
      </tr>
      <tr>
        <td class="meta-label">Est. Compensation</td>
        <td><strong>{{ comp_text }}</strong></td>
      </tr>
      <tr>
        <td class="meta-label">Evaluation Verdict</td>
        <td><span style="color: #10b981; font-weight: 600;">{{ verdict }}</span></td>
      </tr>
    </table>

    {% if match_highlights %}
    <div style="margin: 16px 0;">
      <h3 style="font-size: 12px; text-transform: uppercase; color: #475569; letter-spacing: 0.5px; margin-bottom: 6px;">Key Match Highlights</h3>
      <ul style="padding-left: 18px; color: #1e293b; margin: 0; font-size: 13px;">
        {% for highlight in match_highlights %}
        <li style="margin-bottom: 4px;">{{ highlight }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <p style="font-size: 13px; color: #64748b; margin-top: 14px; margin-bottom: 16px;">
      📎 <strong>Attached:</strong> Tailored, single-page ATS-compliant PDF resume generated specifically for this role.
    </p>

    <div style="margin: 24px 0 16px 0; text-align: left;">
      {% if target_email %}
        <!-- Condition A: Direct Contact Email Available -->
        <a href="mailto:{{ target_email }}?subject=Application:%20{{ job_title | urlencode }}&body={{ email_draft | urlencode }}"
           style="background-color: #2563eb; color: #ffffff; padding: 11px 22px; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 700; display: inline-block;">
          ✉ Send Pre-Filled Outreach
        </a>
      {% else %}
        <!-- Condition B: ATS Portal Link Only -->
        <a href="{{ posting_url }}" target="_blank"
           style="background-color: #0f172a; color: #ffffff; padding: 11px 22px; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 700; display: inline-block; border: 1px solid #334155;">
          Open Application Portal ↗
        </a>
        {% if email_draft %}
          <div style="margin-top: 14px; background-color: #f8fafc; border-left: 3px solid #cbd5e1; padding: 10px 14px; border-radius: 0 4px 4px 0;">
            <span style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Pre-Generated Pitch Draft (Copy & Paste):</span>
            <p style="font-size: 12px; color: #334155; line-height: 1.5; margin: 6px 0 0 0; white-space: pre-line;">{{ email_draft }}</p>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
  <div class="footer">
    Sent autonomously by <strong>BeaconAI</strong> Job Intelligence Engine.<br>
    Deterministic Zero-Trust Architecture • All rights reserved.
  </div>
</div>
</body>
</html>
